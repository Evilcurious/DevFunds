# ==============================================================================
# DevFunds — Environment Configuration (Vercel + Neon OR Linux VPS + Postgres)
# ==============================================================================

# PostgreSQL / Neon Connection URL
# - On Vercel: automatically populated when you connect a Neon database in Vercel Storage
#   (supports DATABASE_URL, POSTGRES_URL, DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING)
# - On VPS: standard PostgreSQL connection string, e.g.:
#   postgresql://devfunds:strongpassword@localhost:5432/devfunds
# - Local Preview: when omitted, falls back automatically to embedded PGlite storage.
DATABASE_URL=

# Optional explicit JWT secret (32+ random characters).
# If omitted, a deterministic HMAC secret is derived automatically.
AUTH_SECRET=
